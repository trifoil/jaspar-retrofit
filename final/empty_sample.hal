#  ---Use external manual tool change dialog---

loadusr -W hal_manualtoolchange
net tool-change-request    =>  hal_manualtoolchange.change
net tool-change-confirmed  <=  hal_manualtoolchange.changed
net tool-number            =>  hal_manualtoolchange.number

#  ---ignore tool prepare requests---
net tool-prepare-loopback   iocontrol.0.tool-prepare      =>  iocontrol.0.tool-prepared



# Jog MPG - Add to your existing HAL file
loadrt encoder num_chan=1
loadrt mux4 count=1
addf encoder.capture-position servo-thread
addf encoder.update-counters base-thread
addf mux4.0 servo-thread

# MPG encoder configuration
setp encoder.0.x4-mode 1  # Set to 1 for quadrature, 0 for single pulse per click

# Set jog velocity mode (0 = position mode, 1 = velocity mode)
setp axis.x.jog-vel-mode 0
setp axis.y.jog-vel-mode 0
setp axis.z.jog-vel-mode 0

# Jog scale settings for the mux
setp mux4.0.in0 0.1      # Coarse scale
setp mux4.0.in1 0.01     # Medium scale  
setp mux4.0.in2 0.001    # Fine scale
setp mux4.0.in3 0.0001   # Extra fine scale

# MPG encoder inputs (from TB5)
net mpg-a encoder.0.phase-A <= hm2_7i76e.0.7i76.0.0.input-16  # A+ on INPUT16
net mpg-b encoder.0.phase-B <= hm2_7i76e.0.7i76.0.0.input-17  # B+ on INPUT17

# Jog enable button (from TB5)
net mpg-enable-btn <= hm2_7i76e.0.7i76.0.0.input-20  # INPUT20

# Create axis select signals (you may need to add physical switches for these)
# For now, we'll create manual selection signals
setp axis.x.jog-enable 0
setp axis.y.jog-enable 0  
setp axis.z.jog-enable 0

# Or use these if you have physical axis select switches:
# net x-select axis.x.jog-enable <= hm2_7i76e.0.7i76.0.0.input-xx
# net y-select axis.y.jog-enable <= hm2_7i76e.0.7i76.0.0.input-xx
# net z-select axis.z.jog-enable <= hm2_7i76e.0.7i76.0.0.input-xx

# Connect encoder counts to all axes
net mpg-counts <= encoder.0.counts
net mpg-counts => axis.x.jog-counts
net mpg-counts => axis.y.jog-counts
net mpg-counts => axis.z.jog-counts

# Connect mux output to jog scales
net mpg-scale <= mux4.0.out
net mpg-scale => axis.x.jog-scale
net mpg-scale => axis.y.jog-scale
net mpg-scale => axis.z.jog-scale

# Enable jogging only when the MPG enable button is pressed AND machine is enabled
net jog-enabled not.in0 <= mpg-enable-btn
net jog-enabled => axis.x.jog-enable
net jog-enabled => axis.y.jog-enable
net jog-enabled => axis.z.jog-enable

# Add scale selection if you have scale select switches
# For example, if you have 2 switches for 4 scales:
# net scale-sel0 mux4.0.sel0 <= hm2_7i76e.0.7i76.0.0.input-xx
# net scale-sel1 mux4.0.sel1 <= hm2_7i76e.0.7i76.0.0.input-xx

# Manual scale selection (comment out if using physical switches)
setp mux4.0.sel0 0
setp mux4.0.sel1 0