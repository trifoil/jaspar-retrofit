#***********************
#  MPG / Jog wheel logic
#***********************

# Hardware as per your README:
# - Encoder A (A+) -> TB3 pin 16 -> hm2 input enc0 A
# - Encoder B (B+) -> TB3 pin 17 -> hm2 enc0 B
# - Jog enable push button -> TB5 pin 5 -> INPUT20
# - Speed selector: TB5 pin 6 INPUT21 (X1), TB5 pin 7 INPUT22 (X100)
#    If none selected -> X10 (default)
# - Axis selector: TB5 pin 8 INPUT23 (X), TB5 pin 9 INPUT24 (Z)
#    If none selected -> Y

# Encoder count -> use existing encoder 0 on the 7i76e
net jog-enc-count <=  hm2_7i76e.0.7i76.0.0.enc0.count

# Route the encoder count to all three axes jog-counts.
# The selected axis will respond (selector logic below).
net jog-enc-count => axis.x.jog-counts
net jog-enc-count => axis.y.jog-counts
net jog-enc-count => axis.z.jog-counts

# MUX for jog scale selection (4 states)
# We'll map:
#  sel1 sel0  (mux select bits)
#   0    0   -> X10 (default when none selected)
#   0    1   -> X1
#   1    0   -> X100
#   1    1   -> X10 (fallback)
#
# IMPORTANT: If you find the scale reversed, swap sel0/sel1 wiring below
setp mux4.0.in0 10.0   # binary 00 -> default X10
setp mux4.0.in1 1.0    # binary 01 -> X1
setp mux4.0.in2 100.0  # binary 10 -> X100
setp mux4.0.in3 10.0   # binary 11 -> fallback X10

# Connect selector input bits to mux select pins
# TB5 pin 6 -> INPUT21 -> X1 (low-order bit)
# TB5 pin 7 -> INPUT22 -> X100 (high-order bit)
net mux_sel0 <=  hm2_7i76e.0.7i76.0.0.input-21 => mux4.0.sel0
net mux_sel1 <=  hm2_7i76e.0.7i76.0.0.input-22 => mux4.0.sel1

# Feed the chosen scale to all axes' jog-scale
net mux4.0.out => axis.x.jog-scale
net mux4.0.out => axis.y.jog-scale
net mux4.0.out => axis.z.jog-scale

# Encoder enable logic:
# enable when (any scale bit is set) AND jog-enable button pressed.
# jog-enable button -> TB5 pin 5 -> INPUT20
net scale-bit-or-in0  <= mux_sel0 => or2.3.in0
net scale-bit-or-in1  <= mux_sel1 => or2.3.in1
# or2.3.out is true if either selector bit is 1
# now AND with the physical jog-enable pushbutton
net hw_jog_button <= hm2_7i76e.0.7i76.0.0.input-20
net or2.3.out => and2.0.in0
net hw_jog_button => and2.0.in1

# and2.0.out is the final jog-enable signal (true when scale selected AND button pressed)
# Route it to all axis jog-enable signals (only the selected axis should respond)
net and2.0.out => axis.x.jog-enable
net and2.0.out => axis.y.jog-enable
net and2.0.out => axis.z.jog-enable

# Axis selector logic:
# TB5 pin 8 -> INPUT23 selects X
# TB5 pin 9 -> INPUT24 selects Z
# If neither selected -> Y selected (default)
#
# Implement: X and Z map directly to halui.axis.*.select.
# Y select is the NOT of (X OR Z)
net hw_sel_x <= hm2_7i76e.0.7i76.0.0.input-23
net hw_sel_z <= hm2_7i76e.0.7i76.0.0.input-24

# OR X and Z
net hw_sel_x => or2.0.in0
net hw_sel_z => or2.0.in1
# Note: or2.0 instance is available because we loaded or2 count=4 earlier.
# Feed its output to a NOT to get Y selected when neither X nor Z are pressed
net or2.0.out => not.0.in
net not.0.out => halui.axis.y.select

# Map X and Z buttons directly to HALUI selects
net hw_sel_x => halui.axis.x.select
net hw_sel_z => halui.axis.z.select

# NOTE:
# - We used or2.0 and or2.3 instances from the same or2 count=4 load.
# - If you want additional safety (e.g. latching, edge-detect, debounce), add more HAL logic.
# - If encoder counts increment when scale bits are zero and you don't want that, adjust
#   by gating jog-enc-count through a buffer controlled by and2.0.out. Currently we route counts
#   to all axes and gate movement using axis.*.jog-enable, which is simpler and commonly used.

#***********************
# end of MPG / Jog logic
#***********************


#  ---coolant signals---

net coolant-mist      <=  iocontrol.0.coolant-mist
net coolant-flood     <=  iocontrol.0.coolant-flood

#  ---probe signal---

net probe-in     =>  motion.probe-input

#  ---motion control signals---

net in-position               <=  motion.in-position
net machine-is-enabled        <=  motion.motion-enabled

#  ---digital in / out signals---

#  ---estop signals---

# --- Physical E-stop on INPUT18 ---
# Normally open: 0 = OK, 1 = E-stop pressed

net estop-in    <=  hm2_7i76e.0.7i76.0.0.input-18
net estop-in    =>  iocontrol.0.emc-enable-in

#  ---manual tool change signals---

net tool-change-request    <= iocontrol.0.tool-change
